EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Clé publique du widget Cloudflare Turnstile (mode "Managed").
# Si vide en local, scripts/set-env.js utilise automatiquement la clé de test
# Cloudflare (toujours réussie) : 1x00000000000000000000AA
TURNSTILE_SITE_KEY=

# Clé secrète Turnstile : UNIQUEMENT utilisée côté serveur (api/contact.ts),
# jamais injectée dans le bundle Angular. En local, tu peux utiliser la clé de
# test Cloudflare (toujours réussie) : 1x0000000000000000000000000000000AA
# En production : à définir dans Vercel > Project Settings > Environment Variables.
TURNSTILE_SECRET_KEY=
